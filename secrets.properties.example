# Example configuration for local secrets and runtime backend parameters.
#
# Copy this file or add these entries to your local.properties (which is gitignored):
#
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_ANON_KEY=your-supabase-anon-key
#   SPOTIFY_SPDC=your-optional-spotify-sp-dc-cookie
#   LASTFM_API_KEY=your-optional-lastfm-api-key
#   LASTFM_SECRET=your-optional-lastfm-api-secret
#   LISTEN_TOGETHER_SERVER=https://party.vibramusic.store
#
# In CI (GitHub Actions), provide these variables as repository Secrets or Environment Variables:
#   - SUPABASE_URL
#   - SUPABASE_ANON_KEY
#   - SPOTIFY_SPDC (optional)
#   - LASTFM_API_KEY (optional)
#   - LASTFM_SECRET (optional)
#
# Never commit real credentials, service keys, or private tokens to source control.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SPOTIFY_SPDC=
LASTFM_API_KEY=
LASTFM_SECRET=
LISTEN_TOGETHER_SERVER=https://party.vibramusic.store
